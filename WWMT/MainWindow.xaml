<Window x:Class="ModelTool.MainWindow"
        x:Name="MyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ModelTool.ViewModel"
        xmlns:local="clr-namespace:ModelTool"
        mc:Ignorable="d"
        Title="WWMT" Height="800" Width="1300"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Grid>
        <Border CornerRadius="15,15,10,10" ClipToBounds="True">
            <Border.Background>
                <ImageBrush ImageSource="{Binding Global.Path}"
                            Stretch="UniformToFill"/>
            </Border.Background>
        </Border>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="76*" MaxHeight="76" MinHeight="76"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" CornerRadius="15,15,0,0" Background="Black"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Border.OpacityMask>
                    <LinearGradientBrush EndPoint="0,1" StartPoint="0,0">
                        <GradientStop Color="Black" Offset="0"/>
                        <GradientStop Color="#00000000" Offset="1"/>
                        <GradientStop Color="#97000000" Offset="0.723"/>
                    </LinearGradientBrush>
                </Border.OpacityMask>

                <Grid>
                    <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                        <TextBlock Text="WWMT" FontSize="25" FontFamily="Century Gothic" FontWeight="Bold" Foreground="White" Margin="10,20,10,10"/>
                        <Button Width="65" Margin="10" Style="{StaticResource base}"
                                Command="{Binding ToBili}">
                            <Image Source="{Binding Global.BiliImage}" Margin="10"/>
                        </Button>
                        <Button Width="65" Margin="10" Style="{StaticResource base}"
                                Command="{Binding ToGitHub}">
                            <Image Source="{Binding Global.GitHubImage}" Margin="10"/>
                        </Button>
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button Content="-" FontSize="30" FontWeight="Bold" Width="65" Margin="10" Style="{StaticResource base}"
                                Click="MinimizeWindow_Click"/>
                        <Button Content="□" FontSize="30" FontWeight="Bold" Width="65" Margin="10" Style="{StaticResource base}"
                                Click="MaximizeWindow_Click"/>
                        <Button Content="×" FontSize="30" FontWeight="Bold" Width="65" Margin="10" Style="{StaticResource base}"
                                Click="CloseWindow_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
            <ContentControl Grid.Row="1" Content="{Binding CurrentContent}" />
        </Grid>
    </Grid>
</Window>
