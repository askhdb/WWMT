<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:v="clr-namespace:ModelTool.View"
                    xmlns:vm="clr-namespace:ModelTool.ViewModel">
    <DataTemplate DataType="{x:Type vm:HomeVM}">
        <v:Home/>
    </DataTemplate>
    
    <DataTemplate DataType="{x:Type vm:SetingVM}">
        <v:Seting/>
    </DataTemplate>
    
    <DataTemplate DataType="{x:Type vm:PathSetVM}">
        <v:PathSet/>
    </DataTemplate>
    
    <DataTemplate DataType="{x:Type vm:IniSetVM}">
        <v:IniSet/>
    </DataTemplate>
    
    <DataTemplate DataType="{x:Type vm:StartSetVM}">
        <v:StartSet/>
    </DataTemplate>
    
    <DataTemplate DataType="{x:Type vm:UpdateSetVM}">
        <v:UpdateSet/>
    </DataTemplate>

</ResourceDictionary>