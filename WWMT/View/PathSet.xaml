<UserControl x:Class="ModelTool.View.PathSet"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:ModelTool.ViewModel"
             xmlns:local="clr-namespace:ModelTool.View"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1071">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="10,10,10,10">
                <TextBlock Text="路径设置" FontSize="25" FontWeight="Bold" Margin="20,0,0,20" Style="{StaticResource TextBlock}"/>
                <StackPanel Height="40" Orientation="Horizontal" Margin="20,0,0,30">
                    <TextBlock Text="GamePath：" Width="120" VerticalAlignment="Center" Style="{StaticResource TextBlock}"/>
                    <Grid Margin="5,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="780"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding GameFileDir}" Width="780" Style="{StaticResource Path}"/>
                        <Button Grid.Column="1" FontSize="20" Content="📁" Width="50" Style="{StaticResource 浏览}"
                                Command="{Binding OpenGameFileDir}"/>
                    </Grid>
                </StackPanel>
                <StackPanel Height="40" Orientation="Horizontal" Margin="20,0,0,30">
                    <TextBlock Text="WWMIPath：" Width="120" VerticalAlignment="Center" Style="{StaticResource TextBlock}"/>
                    <Grid Margin="5,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="780"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding WWMIFileDir}" Width="780" Style="{StaticResource Path}"/>
                        <Button Grid.Column="1" FontSize="20" Content="📁" Width="50" Style="{StaticResource 浏览}"
                                Command="{Binding OpenWWMIFileDir}"/>
                    </Grid>
                </StackPanel>
                <StackPanel Height="40" Orientation="Horizontal" Margin="20,0,0,30">
                    <TextBlock Text="BackgroundImagePath：" Width="200" VerticalAlignment="Center" Style="{StaticResource TextBlock}"/>
                    <Grid Margin="5,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding BackgroundImagePath}" Width="700" Style="{StaticResource Path}"/>
                        <Button Grid.Column="1" FontSize="20" Content="📁" Width="50" Style="{StaticResource 浏览}"
                                Command="{Binding OpenBackgroundImageDir}"/>
                    </Grid>
                </StackPanel>
                <StackPanel Height="40" Orientation="Horizontal" Margin="20,0,0,30">
                    <TextBlock Text="自动配置：" Width="120" VerticalAlignment="Center" Style="{StaticResource TextBlock}"/>
                    <CheckBox Content="切换壁纸" FontSize="20" Style="{StaticResource CheckBox}"
                              IsChecked="{Binding Global.IsRandom, Mode=TwoWay}"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
