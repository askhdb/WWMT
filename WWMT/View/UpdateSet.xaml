<UserControl x:Class="ModelTool.View.UpdateSet"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:ModelTool.ViewModel"
             xmlns:local="clr-namespace:ModelTool.View"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1071">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="10,10,10,10">
                <TextBlock Text="更新设置" FontSize="25" FontWeight="Bold" Margin="20,0,0,20" Style="{StaticResource TextBlock}"/>
                <StackPanel Height="40" Orientation="Horizontal" Margin="20,0,0,30">
                    <TextBlock Text="当前版本：" Width="120" VerticalAlignment="Center" Style="{StaticResource TextBlock}"/>
                    <TextBlock Text="{Binding Version}" Width="120" VerticalAlignment="Center" Style="{StaticResource TextBlock}"/>
                    <Button Content="获取更新" Width="100" Margin="100,0,0,0" Style="{StaticResource 按钮}"
                            Command="{Binding Update}"/>
                </StackPanel>
                <StackPanel Height="40" Orientation="Horizontal" Margin="20,0,0,30">
                    <TextBlock Text="更新选项：" Width="120" VerticalAlignment="Center" Style="{StaticResource TextBlock}"/>
                    <CheckBox Content="自动更新" FontSize="20" Style="{StaticResource CheckBox}"
                              IsChecked="{Binding Autoupdate, Mode=TwoWay}"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
