<UserControl x:Class="ModelTool.View.Home"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:ModelTool.ViewModel"
             xmlns:local="clr-namespace:ModelTool.View"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1300">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="76*" MaxHeight="76" MinHeight="76"/>
            <RowDefinition Height="599*"/>
            <RowDefinition Height="110*" MaxHeight="110" MinHeight="110"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="1">

        </Grid>
        <!--#region line3-->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="650" MinWidth="650"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Global.Path}" Foreground="#777" Margin="10,90,0,0" HorizontalAlignment="Left">
                <TextBlock.Background>
                    <SolidColorBrush Color="Black" Opacity="0.2"/>
                </TextBlock.Background>
            </TextBlock>
            <TextBlock Text="{Binding status}" Foreground="#777" FontSize="25" Margin="10,13,0,26" HorizontalAlignment="Left" Height="35"/>
            <Grid Grid.Column="1" Margin="300,10,50,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="25*"/>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="10*"/>
                </Grid.ColumnDefinitions>
                <Button Content="启动" Opacity="0.8" Style="{StaticResource Start}"
                        Command="{Binding Start}"/>
                <Border Grid.Column="1" Background="Black" Opacity="0.8"/>
                <Button x:Name="SetButton" Grid.Column="2" Opacity="0.8" Style="{StaticResource Set}"
                        Command="{Binding DataContext.ToSeting,RelativeSource={RelativeSource AncestorType=Window}}">
                    <Image Source="{Binding SetImageDir}" Stretch="Fill" Margin="20"/>
                </Button>
            </Grid>
        </Grid>
        <!--#endregion-->
    </Grid>
</UserControl>
