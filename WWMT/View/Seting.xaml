<UserControl x:Class="ModelTool.View.Seting"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:ModelTool.ViewModel"
             xmlns:local="clr-namespace:ModelTool.View"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1300">
    <UserControl.DataContext>
        <vm:SetingVM/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/SetingButtonStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Border CornerRadius="0,0,10,10" Background="Black" Opacity="0.7"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="223*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="1071*"/>
            </Grid.ColumnDefinitions>
            <Grid>
                <Border CornerRadius="15,0,0,10" Background="Black" Opacity="0.5"/>
                <Button Content="返回" Height="80" Margin="10" VerticalAlignment="Top" Style="{StaticResource 列表按钮}"
                        Command="{Binding DataContext.ToHome,ElementName=MyWindow}"/>
                <ScrollViewer Margin="0,100,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10,10,10,10">
                        <Button Content="目录设置" Height="80" Style="{StaticResource 列表按钮}"
                                Command="{Binding ToPathSet}"/>
                        <Button Content="ini设置" Height="80" Style="{StaticResource 列表按钮}"
                                Command="{Binding ToIniSet}"/>
                        <Button Content="启动设置" Height="80" Style="{StaticResource 列表按钮}"
                                Command="{Binding ToStartSet}"/>
                        <Button Content="更新设置" Height="80" Style="{StaticResource 列表按钮}"
                                Command="{Binding ToUpdateSet}"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
            <Grid Grid.Column="2">
                <ContentControl Content="{Binding CurrentContent}" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
